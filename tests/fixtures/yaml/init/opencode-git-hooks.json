{
  "commands": {
    "ai_interactive": "opencode",
    "ai_router": "opencode run {prompt}"
  },
  "default_routine": "develop",
  "hooks": {
    "afterAll": "",
    "afterEach": "git-stash-changes",
    "beforeAll": "",
    "beforeEach": "git-baseline"
  },
  "max_attempts": 3,
  "max_depth": 10,
  "max_log_size": 2097152,
  "routine_source": "~/.decree/routines",
  "routines": {
    "develop": {
      "enabled": true
    },
    "git-baseline": {
      "enabled": true
    },
    "git-stash-changes": {
      "enabled": true
    },
    "rust-develop": {
      "enabled": true
    }
  },
  "shared_routines": {
    "deploy": {
      "enabled": false
    }
  }
}
