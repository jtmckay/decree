{
  "description": "Build, wait for a person to approve, then ship.",
  "initial": "build",
  "name": "deploy",
  "states": {
    "approval": {
      "description": "A person sends approve or reject.",
      "onentry": [
        "ask_person"
      ],
      "timeout_s": 86400,
      "transitions": {
        "approve": "ship",
        "reject": "rejected"
      }
    },
    "build": {
      "invoke": "build",
      "transitions": {
        "done": "approval"
      }
    },
    "done": {
      "final": true
    },
    "failed": {
      "final": true
    },
    "rejected": {
      "final": true
    },
    "ship": {
      "invoke": "ship",
      "transitions": {
        "done": "done"
      }
    }
  }
}
