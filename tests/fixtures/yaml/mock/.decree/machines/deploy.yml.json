{
  "description": "Build, ask a person to approve, then ship.",
  "initial": "build",
  "name": "deploy",
  "states": {
    "approval": {
      "invoke": {
        "ask": "ask_person",
        "choose": "person",
        "question": "Ship this build?",
        "timeout_s": 86400
      },
      "transitions": {
        "approve": {
          "description": "Ship this build.",
          "target": "ship"
        },
        "reject": {
          "description": "Do not ship.",
          "target": "rejected"
        }
      }
    },
    "build": {
      "invoke": "build",
      "transitions": {
        "done": "approval"
      }
    },
    "done": {
      "final": true
    },
    "failed": {
      "final": true
    },
    "rejected": {
      "final": true
    },
    "ship": {
      "invoke": "ship",
      "transitions": {
        "done": "done"
      }
    }
  }
}
