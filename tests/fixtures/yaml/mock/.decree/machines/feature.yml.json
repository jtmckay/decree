{
  "data": {
    "max_rounds": {
      "default": 2,
      "type": "int"
    }
  },
  "description": "Implement one feature spec with an AI agent, verify it, and commit.",
  "initial": "precheck",
  "name": "feature",
  "onentry": [
    "git_baseline"
  ],
  "onexit": [
    "notify"
  ],
  "states": {
    "done": {
      "final": true,
      "onentry": [
        "commit"
      ]
    },
    "failed": {
      "final": true
    },
    "precheck": {
      "invoke": "precheck",
      "transitions": {
        "done": "work"
      }
    },
    "spawn_followups": {
      "emits": [
        "feature"
      ],
      "invoke": "spawn",
      "transitions": {
        "done": "done"
      }
    },
    "work": {
      "initial": "implement",
      "states": {
        "implement": {
          "invoke": "implement",
          "max_attempts": 2,
          "onentry": [
            "snapshot"
          ],
          "onexit": [
            "collect_logs"
          ],
          "transitions": {
            "done": "verify"
          }
        },
        "review": {
          "invoke": {
            "ask": "ask_person",
            "choose": "person",
            "question": "Tests still fail. What next?",
            "timeout_s": 172800
          },
          "transitions": {
            "approve": {
              "description": "Good enough; commit it.",
              "target": "verified"
            },
            "reject": {
              "description": "Stop.",
              "target": "failed"
            },
            "retry": {
              "description": "Try again; see my note.",
              "target": "implement"
            }
          }
        },
        "rounds_left": {
          "invoke": {
            "check": {
              "less_than": {
                "data": "max_rounds"
              },
              "visits": "implement"
            }
          },
          "transitions": {
            "no": "review",
            "yes": "triage"
          }
        },
        "triage": {
          "invoke": {
            "choose": "model",
            "input": "verify",
            "min_confidence": 0.8,
            "question": "Should we implement again or split the work?"
          },
          "transitions": {
            "retry": {
              "description": "The failures look fixable; implement again.",
              "target": "implement"
            },
            "split": {
              "description": "The scope is too large; emit smaller follow-up messages.",
              "target": "spawn_followups"
            },
            "unsure": {
              "target": "review"
            }
          }
        },
        "verified": {
          "final": true
        },
        "verify": {
          "invoke": "verify",
          "transitions": {
            "fail": "rounds_left",
            "pass": "verified"
          }
        }
      },
      "transitions": {
        "done.state.work": "done"
      }
    }
  }
}
