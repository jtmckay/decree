// Grafana Alloy: ship decree's events and script output to Loki.
// Replace /srv/project with the directory that contains .decree/.

local.file_match "decree_events" {
  path_targets = [{"__path__" = "/srv/project/.decree/runs/*/events.jsonl", "job" = "decree"}]
}

loki.source.file "decree_events" {
  targets    = local.file_match.decree_events.targets
  forward_to = [loki.process.decree_events.receiver]
}

loki.process "decree_events" {
  stage.json {
    expressions = { ts = "", type = "", machine = "", run_id = "" }
  }
  // Use decree's own timestamp, not the time Alloy read the line.
  stage.timestamp {
    source = "ts"
    format = "RFC3339"
  }
  // Labels: low cardinality only. run_id is metadata, never a label.
  stage.labels {
    values = { type = "", machine = "" }
  }
  stage.structured_metadata {
    values = { run_id = "" }
  }
  // Prometheus metrics from each run's last line, served on Alloy's own /metrics.
  stage.match {
    selector = "{type=\"run_finished\"}"
    stage.json {
      expressions = { state = "", duration_ms = "" }
    }
    stage.labels {
      values = { state = "" }
    }
    // A metric takes the line's labels; filename names the run, so it would make
    // one series per run.
    stage.label_drop {
      values = ["filename"]
    }
    stage.metrics {
      // decree_runs_total{job, machine, state, type}: success is state="done".
      metric.counter {
        name              = "runs_total"
        prefix            = "decree_"
        description       = "Finished decree runs, by machine and final state."
        match_all         = true
        action            = "inc"
        max_idle_duration = "168h"
      }
      // decree_run_duration_milliseconds{job, machine, state, type}.
      metric.histogram {
        name              = "run_duration_milliseconds"
        prefix            = "decree_"
        description       = "Wall time of finished decree runs."
        source            = "duration_ms"
        buckets           = [1000, 10000, 60000, 300000, 900000, 3600000, 14400000]
        max_idle_duration = "168h"
      }
    }
  }
  forward_to = [loki.write.default.receiver]
}

local.file_match "decree_script_output" {
  path_targets = [{"__path__" = "/srv/project/.decree/runs/*/*.log", "job" = "decree_script"}]
}

loki.source.file "decree_script_output" {
  targets    = local.file_match.decree_script_output.targets
  forward_to = [loki.process.decree_script_output.receiver]
}

loki.process "decree_script_output" {
  // runs/<run_id>/<NNNN>-<state>-<script>.log, or <NNNN>-<state>.log when the script is
  // named as its state; names cannot contain "-".
  stage.regex {
    source     = "filename"
    expression = "/runs/(?P<run_id>[^/]+)/(?P<n>\\d{4,})-(?P<state>[^-/]+?)(?:-(?P<script>[^-/]+))?\\.log$"
  }
  stage.template {
    source   = "script"
    template = "{{ if .script }}{{ .script }}{{ else }}{{ .state }}{{ end }}"
  }
  stage.labels {
    values = { script = "" }
  }
  stage.structured_metadata {
    values = { run_id = "", state = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
