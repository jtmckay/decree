# The local model that writes the issue (Ollama's /api/chat).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Where issues go, from the project root.
NEWSLETTER_DIR=newsletter
# The most new items gather hands to the model, newest first.
NEWSLETTER_MAX_ITEMS=60
# Uncomment to get a ping on each issue (https://ntfy.sh).
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=my-newsletter
